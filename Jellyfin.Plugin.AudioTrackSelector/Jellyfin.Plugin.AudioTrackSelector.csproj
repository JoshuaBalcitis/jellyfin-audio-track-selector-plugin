<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.AudioTrackSelector</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.AudioTrackSelector</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>3.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin 12.2.0 Dependencies -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.2.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
